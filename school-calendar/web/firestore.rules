rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/schedules/{scheduleId} {
      function ownsSchedule() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validSchedule(data) {
        return data.keys().hasAll([
            'title', 'date', 'time', 'type', 'alert_time', 'repeat_type', 'description'
          ])
          && data.keys().hasOnly([
            'title', 'date', 'time', 'type', 'alert_time', 'repeat_type', 'description',
            'locationName', 'locationLat', 'locationLng'
          ])
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 120
          && data.date is string
          && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.time is string
          && data.time.matches('^[0-9]{2}:[0-9]{2}$')
          && data.type is string
          && data.type.size() <= 40
          && data.alert_time in ['none', '1day', '3day', '1week']
          && data.repeat_type in ['none', 'weekly', 'yearly']
          && data.description is string
          && data.description.size() <= 1000
          && (!data.keys().hasAny(['locationName']) || (data.locationName is string && data.locationName.size() <= 120))
          && (!data.keys().hasAny(['locationLat']) || data.locationLat == null || (data.locationLat is number && data.locationLat >= -90 && data.locationLat <= 90))
          && (!data.keys().hasAny(['locationLng']) || data.locationLng == null || (data.locationLng is number && data.locationLng >= -180 && data.locationLng <= 180));
      }

      allow read, delete: if ownsSchedule();
      allow create, update: if ownsSchedule() && validSchedule(request.resource.data);
    }
  }
}
